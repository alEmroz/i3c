# exec_always feh --bg-scale --zoom fill ~/.config/i3/background.jpg
exec_always feh --bg-scale ~/.config/i3/background.jpg
# exec_always feh --bg-scale ~/.config/i3/umi.png
exec_always --no-startup-id ~/.config/polybar/launch.sh

# Activating the second monitor and placing it to the right of the primary one
# exec_always xrandr --output HDMI-2 --auto --right-of eDP-1
exec_always xrandr --output HDMI-2 --auto --above eDP-1
exec_always xrandr --output HDMI-2 --set "Broadcast RGB" "Full" # for the LGTV


# invert scrolling and mouse sensitivity respectively
# --- Mouse ---
exec --no-startup-id xinput set-prop 9 "libinput Natural Scrolling Enabled" 0
exec --no-startup-id xinput set-prop 9 "libinput Accel Speed" 1

# --- Touchpad ---
exec --no-startup-id xinput set-prop "Synaptics TM3145-007" "libinput Natural Scrolling Enabled" 1
exec --no-startup-id xinput set-prop "Synaptics TM3145-007" "libinput Accel Speed" 1
exec --no-startup-id xinput set-prop "Synaptics TM3145-007" "libinput Tapping Enabled" 1

# --- TrackPoint ---
exec --no-startup-id xinput set-prop "TPPS/2 IBM TrackPoint" "libinput Natural Scrolling Enabled" 1
exec --no-startup-id xinput set-prop "TPPS/2 IBM TrackPoint" "libinput Accel Speed" 0.1

exec --no-startup-id setxkbmap -option "caps:escape_shifted_capslock"
exec --no-startup-id xmodmap ~/.xmodmap

# For the scaling issues
exec --no-startup-id xrdb -merge ~/.Xresources

